{
  "name": "wp-theme-kit",
  "version": "0.3.0",
  "description": "Cross-harness toolkit for developing WordPress themes: checks, scaffolding, previews, packaging, and i18n.",
  "homepage": "https://github.com/FlozeIII/wp-theme-kit#readme",
  "bugs": {
    "url": "https://github.com/FlozeIII/wp-theme-kit/issues"
  },
  "type": "module",
  "bin": {
    "wptk": "bin/wp-theme-kit.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "install.mjs",
    "templates/",
    "skills/",
    "commands/",
    "AGENTS.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    ".claude-plugin/",
    ".codex-plugin/",
    ".agents/"
  ],
  "engines": {
    "node": ">=22.2.0"
  },
  "scripts": {
    "test": "node --test",
    "test:ci": "node --test --test-timeout=180000 --test-force-exit",
    "test:browser:ci": "node --test --test-concurrency=1 --test-timeout=180000 --test-force-exit tests/integration/preview.test.mjs tests/integration/audit-baseline.test.mjs tests/integration/accessibility.test.mjs tests/integration/compare.test.mjs tests/integration/editor-cookie.test.mjs",
    "release:check": "node scripts/release-check.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "check:self": "node bin/wp-theme-kit.mjs check ."
  },
  "keywords": [
    "wordpress",
    "theme",
    "wordpress-theme",
    "claude-code",
    "codex",
    "deepseek",
    "agent-skills"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FlozeIII/wp-theme-kit.git"
  },
  "author": {
    "name": "FlozeIII"
  }
}
